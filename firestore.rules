rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidUserId(uid) {
      return uid is int && uid >= 1 && uid <= 20;
    }

    match /chat_messages/{messageId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'senderId', 'senderName', 'timestamp'])
        && request.resource.data.id is string
        && isValidUserId(request.resource.data.senderId)
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 100
        && request.resource.data.timestamp is int;
      allow delete: if true;
    }

    match /media_files/{mediaId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'dataUrl', 'createdAt'])
        && request.resource.data.id is string
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 950000
        && request.resource.data.createdAt is int;
      allow delete: if true;
    }

    match /user_challenges/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['userId', 'challenge', 'trades', 'updatedAt'])
        && isValidUserId(request.resource.data.userId)
        && request.resource.data.updatedAt is int;
      allow delete: if true;
    }
  }
}
